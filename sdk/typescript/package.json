{
  "name": "@jianyunyi/agentops",
  "version": "0.1.0",
  "description": "Server-side TypeScript SDK for AgentScope event ingestion",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
