# Copy to agentops.env and set secret values locally. Never commit that file.
AGENTOPS_WEB_IMAGE=ghcr.io/jianyunyi/agentops-web@sha256:REPLACE_WITH_RELEASE_DIGEST
AGENTOPS_API_IMAGE=ghcr.io/jianyunyi/agentops-api@sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_PORT=3300
API_PORT=8080
MYSQL_PASSWORD=
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_TLS_SERVER_NAME=
SESSION_SECRET=
AGENT_SIGNING_ENCRYPTION_KEY=
ENABLE_LOCAL_LLM=false
